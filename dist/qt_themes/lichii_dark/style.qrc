<RCC>
    <qresource prefix="icons/lichii_dark">
        <file alias="index.theme">icons/index.theme</file>
    </qresource>

    <qresource prefix="lichii_rc">
        <file alias="arrow_down.svg">rc/arrow_down.svg</file>
        <file alias="arrow_down_disabled.svg">rc/arrow_down_disabled.svg</file>
        <file alias="arrow_left.svg">rc/arrow_left.svg</file>
        <file alias="arrow_left_disabled.svg">rc/arrow_left_disabled.svg</file>
        <file alias="arrow_right.svg">rc/arrow_right.svg</file>
        <file alias="arrow_right_disabled.svg">rc/arrow_right_disabled.svg</file>
        <file alias="arrow_up.svg">rc/arrow_up.svg</file>
        <file alias="arrow_up_disabled.svg">rc/arrow_up_disabled.svg</file>
        <file alias="check.svg">rc/check.svg</file>
        <file alias="check_disabled.svg">rc/check_disabled.svg</file>
        <file alias="indeterminate.svg">rc/indeterminate.svg</file>
        <file alias="radio_dot.svg">rc/radio_dot.svg</file>
    </qresource>

    <qresource prefix="lichii_dark">
        <file>style.qss</file>
    </qresource>
</RCC>
