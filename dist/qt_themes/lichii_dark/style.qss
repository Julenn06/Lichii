/* Lichii status bar: Ocarina of Time frame rate, out-of-date keys, Switch 2 mode */
QPushButton#OotFpsStatusBarButton,
QPushButton#KeysWarningStatusBarButton {
    min-width: 0px;
    min-height: 0px;
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 2px 8px;
    font-weight: 600;
    font-size: 9pt;
}

QPushButton#OotFpsStatusBarButton:hover {
    background-color: #1d1f25;
    border-color: #2e323b;
}

QPushButton#OotFpsStatusBarButton:checked {
    color: #ff9d5c;
}

QPushButton#OotFpsStatusBarButton:!checked {
    color: #5ee08a;
}

QPushButton#KeysWarningStatusBarButton {
    color: #ffb84d;
    background-color: rgba(255, 184, 77, 0.12);
    border-color: rgba(255, 184, 77, 0.35);
}

QPushButton#KeysWarningStatusBarButton:hover {
    background-color: rgba(255, 184, 77, 0.20);
    border-color: #ffb84d;
}

QLabel#Switch2ModeLabel {
    color: #ffffff;
    background-color: #e6324f;
    border-radius: 6px;
    padding: 1px 8px;
    font-weight: 700;
    font-size: 8pt;
}
