/*
SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
SPDX-License-Identifier: GPL-3.0-or-later

Lichii dark theme. Palette:
  background #121318   surface #1a1c22   raised #22252d   hover #2b2f38
  border #2e323b       soft border #24272e
  text #e8eaf0         secondary #9aa1ad  disabled #5b616c
  accent #ff4f6d (hover #ff6b85, pressed #e23f5c)
*/

* {
    font-family: "Segoe UI Variable Text", "Segoe UI", "Inter", "Noto Sans", sans-serif;
    font-size: 10pt;
    outline: 0;
}

QWidget {
    color: #e8eaf0;
    background-color: transparent;
    selection-background-color: #ff4f6d;
    selection-color: #ffffff;
}

QWidget:disabled {
    color: #5b616c;
}

QMainWindow,
QDialog,
QMessageBox,
QWizard,
QStackedWidget > QWidget#page {
    background-color: #121318;
}

QMainWindow::separator {
    background-color: #24272e;
    width: 1px;
    height: 1px;
}

QLabel,
QCheckBox,
QRadioButton {
    background-color: transparent;
}

QLabel:disabled {
    color: #5b616c;
}

/* ---- Menus ---------------------------------------------------------------------------- */

QMenuBar {
    background-color: #121318;
    border-bottom: 1px solid #1f2128;
    padding: 4px 6px;
    spacing: 2px;
}

QMenuBar::item {
    background-color: transparent;
    color: #c9ced8;
    padding: 6px 12px;
    border-radius: 6px;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: #22252d;
    color: #ffffff;
}

QMenu {
    background-color: #1a1c22;
    border: 1px solid #2e323b;
    border-radius: 10px;
    padding: 6px;
}

QMenu::item {
    background-color: transparent;
    color: #e8eaf0;
    padding: 7px 28px 7px 14px;
    border-radius: 6px;
    margin: 1px 0px;
}

QMenu::item:selected {
    background-color: rgba(255, 79, 109, 0.18);
    color: #ffffff;
}

QMenu::item:disabled {
    color: #5b616c;
    background-color: transparent;
}

QMenu::icon {
    padding-left: 8px;
}

QMenu::separator {
    height: 1px;
    background-color: #2e323b;
    margin: 6px 8px;
}

QMenu::indicator {
    width: 14px;
    height: 14px;
    margin-left: 6px;
    border-radius: 4px;
}

QMenu::indicator:non-exclusive:unchecked {
    border: 1px solid #4a505c;
    background-color: #1a1c22;
}

QMenu::indicator:non-exclusive:checked {
    border: 1px solid #ff4f6d;
    background-color: #ff4f6d;
    image: url(:/lichii_rc/check.svg);
}

QMenu::indicator:exclusive:unchecked {
    border: 1px solid #4a505c;
    border-radius: 7px;
}

QMenu::indicator:exclusive:checked {
    border: 1px solid #ff4f6d;
    border-radius: 7px;
    background-color: #ff4f6d;
    image: url(:/lichii_rc/radio_dot.svg);
}

QMenu::right-arrow {
    image: url(:/lichii_rc/arrow_right.svg);
    width: 12px;
    height: 12px;
    margin-right: 6px;
}

QToolTip {
    background-color: #22252d;
    color: #e8eaf0;
    border: 1px solid #343843;
    border-radius: 6px;
    padding: 6px 8px;
}

/* ---- Buttons -------------------------------------------------------------------------- */

QPushButton,
QToolButton {
    background-color: #22252d;
    color: #e8eaf0;
    border: 1px solid #2e323b;
    border-radius: 8px;
    padding: 6px 16px;
    min-height: 20px;
}

QToolButton {
    padding: 5px 8px;
}

QPushButton:hover,
QToolButton:hover {
    background-color: #2b2f38;
    border-color: #3a3f4a;
}

QPushButton:pressed,
QToolButton:pressed,
QToolButton:checked {
    background-color: #1a1c22;
    border-color: #ff4f6d;
}

QPushButton:checked {
    background-color: rgba(255, 79, 109, 0.18);
    border-color: #ff4f6d;
    color: #ffffff;
}

QPushButton:disabled,
QToolButton:disabled {
    background-color: #17181d;
    border-color: #23262d;
    color: #5b616c;
}

QPushButton:default {
    background-color: #ff4f6d;
    border-color: #ff4f6d;
    color: #ffffff;
    font-weight: 600;
}

QPushButton:default:hover {
    background-color: #ff6b85;
    border-color: #ff6b85;
}

QPushButton:default:pressed {
    background-color: #e23f5c;
    border-color: #e23f5c;
}

QPushButton:default:disabled {
    background-color: #3a2a30;
    border-color: #3a2a30;
    color: #8a7a80;
}

QPushButton::menu-indicator {
    image: url(:/lichii_rc/arrow_down.svg);
    subcontrol-position: right center;
    subcontrol-origin: padding;
    width: 12px;
    height: 12px;
    right: 6px;
}

QDialogButtonBox QPushButton {
    min-width: 92px;
}

QToolButton::menu-indicator,
QToolButton::menu-arrow {
    image: url(:/lichii_rc/arrow_down.svg);
    width: 10px;
    height: 10px;
}

QToolButton#qt_toolbar_ext_button {
    background-color: transparent;
    border: none;
}

/* ---- Text inputs ---------------------------------------------------------------------- */

QLineEdit,
QAbstractSpinBox,
QPlainTextEdit,
QTextEdit,
QTextBrowser,
QKeySequenceEdit,
QDateTimeEdit {
    background-color: #1a1c22;
    color: #e8eaf0;
    border: 1px solid #2e323b;
    border-radius: 8px;
    padding: 5px 10px;
    selection-background-color: #ff4f6d;
}

QPlainTextEdit,
QTextEdit,
QTextBrowser {
    padding: 6px;
}

QLineEdit:hover,
QAbstractSpinBox:hover,
QPlainTextEdit:hover,
QTextEdit:hover {
    border-color: #3a3f4a;
}

QLineEdit:focus,
QAbstractSpinBox:focus,
QPlainTextEdit:focus,
QTextEdit:focus {
    border-color: #ff4f6d;
}

QLineEdit:disabled,
QAbstractSpinBox:disabled,
QPlainTextEdit:disabled,
QTextEdit:disabled {
    background-color: #17181d;
    border-color: #23262d;
    color: #5b616c;
}

QLineEdit[readOnly="true"] {
    background-color: #17181d;
}

QAbstractSpinBox {
    padding-right: 22px;
}

QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    width: 20px;
    border: none;
    background-color: transparent;
}

QAbstractSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 8px;
}

QAbstractSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 8px;
}

QAbstractSpinBox::up-button:hover,
QAbstractSpinBox::down-button:hover {
    background-color: #2b2f38;
}

QAbstractSpinBox::up-arrow {
    image: url(:/lichii_rc/arrow_up.svg);
    width: 10px;
    height: 10px;
}

QAbstractSpinBox::down-arrow {
    image: url(:/lichii_rc/arrow_down.svg);
    width: 10px;
    height: 10px;
}

QAbstractSpinBox::up-arrow:disabled,
QAbstractSpinBox::up-arrow:off {
    image: url(:/lichii_rc/arrow_up_disabled.svg);
}

QAbstractSpinBox::down-arrow:disabled,
QAbstractSpinBox::down-arrow:off {
    image: url(:/lichii_rc/arrow_down_disabled.svg);
}

/* ---- Combo boxes ---------------------------------------------------------------------- */

QComboBox {
    background-color: #22252d;
    color: #e8eaf0;
    border: 1px solid #2e323b;
    border-radius: 8px;
    padding: 5px 30px 5px 10px;
    min-height: 20px;
}

QComboBox:hover {
    background-color: #2b2f38;
    border-color: #3a3f4a;
}

QComboBox:on,
QComboBox:focus {
    border-color: #ff4f6d;
}

QComboBox:editable {
    background-color: #1a1c22;
}

QComboBox:disabled {
    background-color: #17181d;
    border-color: #23262d;
    color: #5b616c;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 26px;
    border: none;
}

QComboBox::down-arrow {
    image: url(:/lichii_rc/arrow_down.svg);
    width: 12px;
    height: 12px;
}

QComboBox::down-arrow:disabled {
    image: url(:/lichii_rc/arrow_down_disabled.svg);
}

QComboBox QAbstractItemView {
    background-color: #1a1c22;
    color: #e8eaf0;
    border: 1px solid #2e323b;
    border-radius: 8px;
    padding: 4px;
    outline: 0;
    selection-background-color: rgba(255, 79, 109, 0.22);
    selection-color: #ffffff;
}

QComboBox QAbstractItemView::item {
    min-height: 26px;
    padding: 2px 8px;
    border-radius: 6px;
}

/* ---- Check boxes and radio buttons ---------------------------------------------------- */

QCheckBox,
QRadioButton {
    spacing: 9px;
    padding: 2px 0px;
}

QCheckBox::indicator,
QGroupBox::indicator,
QRadioButton::indicator,
QAbstractItemView::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox::indicator,
QGroupBox::indicator,
QAbstractItemView::indicator {
    border: 1px solid #4a505c;
    border-radius: 5px;
    background-color: #1a1c22;
}

QCheckBox::indicator:hover,
QGroupBox::indicator:hover,
QAbstractItemView::indicator:hover {
    border-color: #ff6b85;
}

QCheckBox::indicator:checked,
QGroupBox::indicator:checked,
QAbstractItemView::indicator:checked {
    border-color: #ff4f6d;
    background-color: #ff4f6d;
    image: url(:/lichii_rc/check.svg);
}

QCheckBox::indicator:indeterminate,
QAbstractItemView::indicator:indeterminate {
    border-color: #ff4f6d;
    background-color: #ff4f6d;
    image: url(:/lichii_rc/indeterminate.svg);
}

QCheckBox::indicator:disabled,
QGroupBox::indicator:disabled {
    border-color: #30333b;
    background-color: #17181d;
}

QCheckBox::indicator:checked:disabled,
QGroupBox::indicator:checked:disabled {
    background-color: #30333b;
    image: url(:/lichii_rc/check_disabled.svg);
}

QRadioButton::indicator {
    border: 1px solid #4a505c;
    border-radius: 9px;
    background-color: #1a1c22;
}

QRadioButton::indicator:hover {
    border-color: #ff6b85;
}

QRadioButton::indicator:checked {
    border-color: #ff4f6d;
    background-color: #ff4f6d;
    image: url(:/lichii_rc/radio_dot.svg);
}

QRadioButton::indicator:disabled {
    border-color: #30333b;
    background-color: #17181d;
}

/* ---- Group boxes, frames and tabs ----------------------------------------------------- */

QGroupBox {
    background-color: #17191e;
    border: 1px solid #24272e;
    border-radius: 12px;
    margin-top: 24px;
    padding: 8px 12px 10px 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 6px;
    padding: 0px 6px 4px 6px;
    color: #c6cbd4;
    font-weight: 600;
    background-color: transparent;
}

QGroupBox::title:disabled {
    color: #5b616c;
}

QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    color: #2a2d35;
    background-color: #2a2d35;
    border: none;
    max-height: 1px;
}

QFrame[frameShape="5"] {
    max-width: 1px;
    max-height: 16777215px;
}

QTabWidget::pane {
    background-color: #15161b;
    border: 1px solid #24272e;
    border-radius: 12px;
    top: -1px;
    padding: 6px;
}

QTabWidget::tab-bar {
    left: 4px;
}

QTabBar {
    background-color: transparent;
    qproperty-drawBase: 0;
}

QTabBar::tab {
    background-color: transparent;
    color: #9aa1ad;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 7px 16px;
    margin: 0px 4px 6px 0px;
}

QTabBar::tab:hover {
    background-color: #1d1f25;
    color: #e8eaf0;
}

QTabBar::tab:selected {
    background-color: rgba(255, 79, 109, 0.16);
    border-color: rgba(255, 79, 109, 0.45);
    color: #ffffff;
    font-weight: 600;
}

QTabBar::tab:disabled {
    color: #4a4f59;
}

QTabBar::close-button {
    subcontrol-position: right;
}

QTabBar QToolButton {
    background-color: #1a1c22;
    border-radius: 6px;
    padding: 2px;
}

QTabBar QToolButton::left-arrow {
    image: url(:/lichii_rc/arrow_left.svg);
}

QTabBar QToolButton::right-arrow {
    image: url(:/lichii_rc/arrow_right.svg);
}

/* ---- Lists, trees and tables (the game list) ------------------------------------------ */

QAbstractScrollArea {
    background-color: #121318;
    border: none;
}

QAbstractItemView {
    background-color: #121318;
    alternate-background-color: #15161b;
    color: #e8eaf0;
    border: none;
    selection-background-color: rgba(255, 79, 109, 0.20);
    selection-color: #ffffff;
    show-decoration-selected: 1;
}

QAbstractItemView::item {
    padding: 4px 6px;
    border: none;
}

QAbstractItemView::item:hover {
    background-color: #1b1d23;
}

QAbstractItemView::item:selected {
    background-color: rgba(255, 79, 109, 0.20);
    color: #ffffff;
}

QAbstractItemView::item:selected:!active {
    background-color: rgba(255, 79, 109, 0.12);
}

QListView,
QListWidget {
    background-color: #15161b;
    border: 1px solid #24272e;
    border-radius: 10px;
    padding: 4px;
}

QListView::item,
QListWidget::item {
    border-radius: 6px;
    padding: 5px 8px;
}

QTreeView::branch {
    background-color: transparent;
}

QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: url(:/lichii_rc/arrow_right.svg);
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: url(:/lichii_rc/arrow_down.svg);
}

QHeaderView {
    background-color: #121318;
    border: none;
}

QHeaderView::section {
    background-color: #121318;
    color: #9aa1ad;
    border: none;
    border-bottom: 1px solid #24272e;
    padding: 7px 4px;
}

QHeaderView::section:hover {
    color: #e8eaf0;
}

QHeaderView::section:checked {
    color: #ff8fa3;
}

QHeaderView::down-arrow {
    image: url(:/lichii_rc/arrow_down.svg);
    width: 10px;
    height: 10px;
    padding-right: 6px;
}

QHeaderView::up-arrow {
    image: url(:/lichii_rc/arrow_up.svg);
    width: 10px;
    height: 10px;
    padding-right: 6px;
}

QTableCornerButton::section {
    background-color: #121318;
    border: none;
}

/* The settings dialog: pages scroll inside the tab instead of being squeezed. */
QScrollArea#SettingsPageScroll,
QScrollArea#SettingsPageScroll > QWidget,
QScrollArea#SettingsPageScroll > QWidget > QWidget {
    background-color: transparent;
}

/* The settings dialog: its section list becomes a sidebar. */
QListWidget#selectorList {
    background-color: #15161b;
    border: 1px solid #24272e;
    border-radius: 12px;
    padding: 6px;
    min-width: 170px;
    max-width: 170px;
}

QListWidget#selectorList::item {
    color: #b8bec9;
    padding: 9px 12px;
    margin: 1px 0px;
    border-radius: 8px;
}

QListWidget#selectorList::item:hover {
    background-color: #1d1f25;
    color: #ffffff;
}

QListWidget#selectorList::item:selected {
    background-color: rgba(255, 79, 109, 0.18);
    color: #ffffff;
    font-weight: 600;
}

/* ---- Scroll bars ---------------------------------------------------------------------- */

QScrollBar:vertical {
    background-color: transparent;
    width: 12px;
    margin: 2px;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 12px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #2e323b;
    border-radius: 4px;
    min-height: 32px;
    margin: 0px 2px;
}

QScrollBar::handle:horizontal {
    background-color: #2e323b;
    border-radius: 4px;
    min-width: 32px;
    margin: 2px 0px;
}

QScrollBar::handle:hover {
    background-color: #464b57;
}

QScrollBar::handle:pressed {
    background-color: #ff4f6d;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0px;
    height: 0px;
    border: none;
    background: none;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
}

/* ---- Sliders and progress bars -------------------------------------------------------- */

QSlider {
    background-color: transparent;
    min-height: 22px;
}

QSlider::groove:horizontal {
    height: 4px;
    background-color: #2e323b;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background-color: #ff4f6d;
    border-radius: 2px;
}

QSlider::groove:vertical {
    width: 4px;
    background-color: #2e323b;
    border-radius: 2px;
}

QSlider::add-page:vertical {
    background-color: #ff4f6d;
    border-radius: 2px;
}

QSlider::handle:horizontal,
QSlider::handle:vertical {
    background-color: #ffffff;
    border: 3px solid #ff4f6d;
    width: 10px;
    height: 10px;
    border-radius: 8px;
}

QSlider::handle:horizontal {
    margin: -7px 0px;
}

QSlider::handle:vertical {
    margin: 0px -7px;
}

QSlider::handle:hover {
    border-color: #ff6b85;
}

QSlider::sub-page:horizontal:disabled,
QSlider::add-page:vertical:disabled {
    background-color: #3a3d45;
}

QSlider::handle:disabled {
    background-color: #5b616c;
    border-color: #3a3d45;
}

QProgressBar {
    background-color: #1a1c22;
    border: 1px solid #24272e;
    border-radius: 7px;
    color: #e8eaf0;
    text-align: center;
    min-height: 14px;
}

QProgressBar::chunk {
    background-color: #ff4f6d;
    border-radius: 6px;
}

/* ---- Status bar ----------------------------------------------------------------------- */

QStatusBar {
    background-color: #0f1014;
    border-top: 1px solid #1f2128;
    color: #9aa1ad;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: #9aa1ad;
    padding: 0px 6px;
}

QPushButton#TogglableStatusBarButton,
QPushButton#RendererStatusBarButton,
QPushButton#GPUStatusBarButton,
QPushButton#DockingStatusBarButton,
QPushButton#RefreshButton {
    min-width: 0px;
    min-height: 0px;
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 2px 8px;
    color: #6b717d;
    font-weight: 600;
    font-size: 9pt;
}

QPushButton#TogglableStatusBarButton:hover,
QPushButton#RendererStatusBarButton:hover,
QPushButton#GPUStatusBarButton:hover,
QPushButton#DockingStatusBarButton:hover,
QPushButton#RefreshButton:hover {
    background-color: #1d1f25;
    border-color: #2e323b;
}

QPushButton#TogglableStatusBarButton:checked {
    color: #e8eaf0;
}

QPushButton#DockingStatusBarButton {
    color: #e8eaf0;
}

QPushButton#RendererStatusBarButton:checked {
    color: #ff9d5c;
}

QPushButton#RendererStatusBarButton:!checked {
    color: #4fd6e6;
}

QPushButton#GPUStatusBarButton:checked {
    color: #ff9d5c;
}

QPushButton#GPUStatusBarButton:!checked {
    color: #5ee08a;
}

/* ---- Misc ----------------------------------------------------------------------------- */

QSplitter::handle {
    background-color: #1f2128;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

QSizeGrip {
    width: 12px;
    height: 12px;
}

QDockWidget {
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QDockWidget::title {
    background-color: #1a1c22;
    padding: 6px;
}

QCalendarWidget QWidget {
    alternate-background-color: #1a1c22;
}

/* ---- Application-specific widgets (controller applet, software keyboard, ...) --------- */
QPushButton#buttonRefreshDevices {
    min-width: 23px;
    min-height: 23px;
    max-width: 23px;
    max-height: 23px;
    padding: 0px 0px;
}

QSpinBox#spinboxLStickRange,
QSpinBox#spinboxRStickRange,
QSpinBox#vibrationSpinPlayer1,
QSpinBox#vibrationSpinPlayer2,
QSpinBox#vibrationSpinPlayer3,
QSpinBox#vibrationSpinPlayer4,
QSpinBox#vibrationSpinPlayer5,
QSpinBox#vibrationSpinPlayer6,
QSpinBox#vibrationSpinPlayer7,
QSpinBox#vibrationSpinPlayer8 {
    min-width: 68px;
}

QDialog#ConfigureVibration QGroupBox::indicator,
QGroupBox#motionGroup::indicator,
QGroupBox#vibrationGroup::indicator {
    margin-left: 0px;
}

QDialog#ConfigureVibration QGroupBox::title,
QGroupBox#motionGroup::title,
QGroupBox#vibrationGroup::title {
    spacing: 2px;
    padding-left: 1px;
    padding-right: 1px;
}

QWidget#bottomPerGameInput,
QWidget#topControllerApplet,
QWidget#bottomControllerApplet,
QGroupBox#groupPlayer1Connected:checked,
QGroupBox#groupPlayer2Connected:checked,
QGroupBox#groupPlayer3Connected:checked,
QGroupBox#groupPlayer4Connected:checked,
QGroupBox#groupPlayer5Connected:checked,
QGroupBox#groupPlayer6Connected:checked,
QGroupBox#groupPlayer7Connected:checked,
QGroupBox#groupPlayer8Connected:checked {
    background-color: #232629;
}

QWidget#topPerGameInput,
QWidget#middleControllerApplet {
    background-color: #31363b;
}

QWidget#topPerGameInput QComboBox,
QWidget#middleControllerApplet QComboBox {
    width: 120px;
}

QWidget#connectedControllers {
    background: transparent;
}

QWidget#closeButtons {
    background: transparent;
}

QWidget#playersSupported,
QWidget#controllersSupported,
QWidget#controllerSupported1,
QWidget#controllerSupported2,
QWidget#controllerSupported3,
QWidget#controllerSupported4,
QWidget#controllerSupported5,
QWidget#controllerSupported6 {
    border: none;
    background: transparent;
}

QGroupBox#groupPlayer1Connected,
QGroupBox#groupPlayer2Connected,
QGroupBox#groupPlayer3Connected,
QGroupBox#groupPlayer4Connected,
QGroupBox#groupPlayer5Connected,
QGroupBox#groupPlayer6Connected,
QGroupBox#groupPlayer7Connected,
QGroupBox#groupPlayer8Connected {
    border: 1px solid #76797c;
    border-radius: 3px;
    padding: 0px;
    min-height: 98px;
